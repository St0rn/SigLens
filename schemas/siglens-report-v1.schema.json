{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/St0rn/SigLens/schemas/siglens-report-v1.schema.json",
  "title": "SigLens report schema v1",
  "type": "object",
  "required": ["schema", "schema_version", "report_type", "generated_at"],
  "properties": {
    "schema": {"const": "siglens-report/v1"},
    "schema_version": {"type": "string", "pattern": "^1\\."},
    "report_type": {
      "type": "string",
      "enum": ["analysis", "artifact_analysis", "script_analysis", "comparison", "source_attribution"]
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "tool": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "author": {"type": "string"}
      },
      "additionalProperties": true
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {"type": "string"},
        "entropy": {"type": "number"},
        "hashes": {
          "type": "object",
          "required": ["sha256", "size"],
          "properties": {
            "md5": {"type": "string"},
            "sha1": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "size": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "pe": {
      "type": "object",
      "properties": {
        "is_pe": {"type": "boolean"},
        "timestamp_utc": {"type": ["string", "null"], "format": "date-time"},
        "security": {
          "type": "object",
          "properties": {
            "architecture": {"type": "string"},
            "is_64bit": {"type": "boolean"},
            "is_dll": {"type": "boolean"},
            "mitigations": {"type": "object"},
            "relocations": {"type": "object"},
            "load_config": {"type": "object"},
            "entry_point": {"type": "object"},
            "section_review": {"type": "object"},
            "authenticode": {"type": "object"},
            "debug": {"type": "array"},
            "tls": {"type": "object"},
            "overlay": {"type": "object"},
            "imphash": {"type": ["string", "null"]},
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "severity", "title", "evidence"],
                "properties": {
                  "id": {"type": "string", "pattern": "^PE[0-9]{3}$"},
                  "severity": {"enum": ["high", "medium", "low", "info"]},
                  "title": {"type": "string"},
                  "evidence": {"type": "object"}
                },
                "additionalProperties": true
              }
            },
            "summary": {
              "type": "object",
              "properties": {
                "high": {"type": "integer", "minimum": 0},
                "medium": {"type": "integer", "minimum": 0},
                "low": {"type": "integer", "minimum": 0},
                "info": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "multiav": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["clean", "detected", "unknown", "unavailable", "error"]
              },
              "offset_source": {
                "type": ["string", "null"],
                "enum": ["native_engine_output", null]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "ghidra_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["classification", "file_offset", "file_offset_hex"],
        "properties": {
          "classification": {
            "type": "string",
            "enum": ["EXACT_MATCH", "NATIVE_ENGINE_OFFSET", "INFERRED_BOUNDARY", "CANDIDATE_REGION", "CONTEXT_DEPENDENT"]
          },
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "file_offset": {"type": "integer", "minimum": 0},
          "file_offset_hex": {"type": "string"},
          "range_start": {"type": ["integer", "null"], "minimum": 0},
          "range_end": {"type": ["integer", "null"], "minimum": 0},
          "rva": {"type": ["integer", "null"]},
          "rva_hex": {"type": ["string", "null"]},
          "va": {"type": ["integer", "null"]},
          "va_hex": {"type": ["string", "null"]},
          "image_base": {"type": ["integer", "null"]},
          "image_base_hex": {"type": ["string", "null"]},
          "ghidra_go_to": {"type": ["string", "null"]},
          "section": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
